manifest {
    name = "tylergross97/vcf_expression_annotator"
    author = "Tyler Gross"
    description = "Nextflow workflow for annotating VCF files with expression data from transcript counts."
    version = "1.0.0"
    mainScript = "main.nf"
    homePage = "https://github.com/tylergross97/vcf_expression_annotator"
    defaultBranch = "main"
}

params {
    // Required parameters
    patient_id = null
    samplesheet = null
    transcript_counts = null
    outdir = null
}

// Configure Nextflow reports
// These reports must NOT use params.outdir to ensure Seqera Platform can display them
// The platform expects reports in the default Nextflow locations
report {
    enabled   = true
    overwrite = true
}

timeline {
    enabled   = true
    overwrite = true
}

dag {
    enabled   = true
    overwrite = true
}

trace {
    enabled   = true
    overwrite = true
}

profiles {
    test {
        // Override parameters for a test dataset
        params {
            patient_id = "PID_262622_"  // The underscore at the end is important for matching sample IDs in the transcript counts files
            samplesheet = "${projectDir}/tests/samplesheet.csv"
            transcript_counts = "${projectDir}/tests/data/salmon.merged.transcript_counts.tsv"
            outdir = "results"  // Default output directory for tests
        }
        // No container configuration here - let it be set by other profiles
    }

    singularity {
        singularity {
            enabled     = true
            autoMounts  = true
        }
    }

    docker {
        docker {
            enabled     = true
        }
    }
}
