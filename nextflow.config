manifest {
    name = "tylergross97/vcf_expression_annotator"
    author = "Tyler Gross"
    description = "Nextflow workflow for annotating VCF files with expression data from transcript counts."
    version = "1.0.0"
    mainScript = "main.nf"
    homePage = "https://github.com/tylergross97/vcf_expression_annotator"
    defaultBranch = "main"
}

params {
    // Required parameters
    patient_id = null
    samplesheet = null
    transcript_counts = null
    
    // Output directory - defaults to ./results
    outdir = 'results'
    
    // Report generation - set to true to force enable HTML reports
    // (automatically disabled on cloud by default)
    enable_reports = null
}

// Set the default output directory
outputDir = params.outdir

// NOTE: Nextflow HTML reports (report.html, timeline.html, dag.html) contain 
// hardcoded relative paths to work directories which don't resolve correctly
// when viewed through the Seqera Platform UI. These reports are best viewed
// by downloading them locally. 
//
// For cloud execution, we disable these reports and rely on:
// 1. Seqera Platform's built-in execution reports and timeline
// 2. The actual pipeline outputs (VCF, CSV files) published via the output block
//
// To enable reports for local execution, use: --enable_reports true

// Helper function to detect cloud execution
def isCloudExecution() {
    return workflow.workDir.toString().startsWith('s3://') || 
           workflow.workDir.toString().startsWith('gs://') || 
           workflow.workDir.toString().startsWith('az://')
}

// Conditionally enable reports (disabled by default on cloud)
def reportsEnabled = params.enable_reports ?: !isCloudExecution()

report {
    enabled   = reportsEnabled
    overwrite = true
    file      = "${params.outdir}/reports/report.html"
}

timeline {
    enabled   = reportsEnabled
    overwrite = true
    file      = "${params.outdir}/reports/timeline.html"
}

dag {
    enabled   = reportsEnabled
    overwrite = true
    file      = "${params.outdir}/reports/dag.html"
}

trace {
    enabled   = true  // Always enable trace as it's plain text and works fine
    overwrite = true
    file      = "${params.outdir}/reports/trace.txt"
}

profiles {
    test {
        // Override parameters for a test dataset
        params {
            patient_id = "PID_262622_"  // The underscore at the end is important for matching sample IDs in the transcript counts files
            samplesheet = "${projectDir}/tests/samplesheet.csv"
            transcript_counts = "${projectDir}/tests/data/salmon.merged.transcript_counts.tsv"
            outdir = "results"  // Default output directory for tests
        }
        // No container configuration here - let it be set by other profiles
    }

    singularity {
        singularity {
            enabled     = true
            autoMounts  = true
        }
    }

    docker {
        docker {
            enabled     = true
        }
    }
}
