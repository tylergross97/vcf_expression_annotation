manifest {
    name = "tylergross97/vcf_expression_annotator"
    author = "Tyler Gross"
    description = "Nextflow workflow for annotating VCF files with expression data from transcript counts."
    version = "1.0.0"
    mainScript = "main.nf"
    homePage = "https://github.com/tylergross97/vcf_expression_annotator"
    defaultBranch = "main"
}

params {
    // Required parameters
    patient_id = null
    samplesheet = null
    transcript_counts = null
    outdir_base = null

    // Optional parameters - these will be set dynamically in the workflow if not provided
    outdir_split_transcript_counts = null
    outdir_vcf_expression_annotator = null
    outdir_clean_vcf = null
}

profiles {
    test {
        // Override parameters for a test dataset
        // NOTE: When using test profile on Seqera Platform, you should override outdir_base
        // with an S3 path in the launch parameters to ensure outputs are published to S3
        params {
            patient_id = "PID_262622_"  // The underscore at the end is important for matching sample IDs in the transcript counts files
            samplesheet = "${projectDir}/tests/samplesheet.csv"
            transcript_counts = "${projectDir}/tests/data/salmon.merged.transcript_counts.tsv"
            
            // Default to local testing path - override this on Platform with S3 path
            outdir_base = "${projectDir}/tests/results"
        }
        // No container configuration here - let it be set by other profiles
    }

    singularity {
        singularity {
            enabled     = true
            autoMounts  = true
        }
    }

    docker {
        docker {
            enabled     = true
        }
    }
}
